OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=30
OPENAI_REASONING_EFFORT=low

TRIP_PLAN_RUN_STORE_PATH=.data/trip_plan_runs.json

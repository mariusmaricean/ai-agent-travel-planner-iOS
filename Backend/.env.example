AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_TIMEOUT_SECONDS=20
AMADEUS_CURRENCY_CODE=USD
AMADEUS_MAX_OFFERS=3
AMADEUS_ADULTS=1
LOCATION_CACHE_MAX_ENTRIES=128
PROVIDER_LOG_LEVEL=INFO

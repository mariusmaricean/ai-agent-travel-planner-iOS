OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=30
OPENAI_REASONING_EFFORT=low

TRIP_PLAN_RUN_STORE_PATH=.data/trip_plan_runs.json
TRIP_PLAN_RUN_WORKERS=2
TRIP_PLAN_JOB_QUEUE_ENABLED=true
TRIP_PLAN_JOB_QUEUE_PATH=.data/trip_plan_jobs.json
TRIP_PLAN_HISTORY_STORE_PATH=.data/trip_plan_history.json
TRIP_PLAN_HISTORY_LIMIT=100

DESTINATION_RESEARCH_PROVIDER=mock
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=12
TICKETMASTER_API_KEY=
TICKETMASTER_EVENTS_URL=https://app.ticketmaster.com/discovery/v2/events.json
TICKETMASTER_TIMEOUT_SECONDS=12
TICKETMASTER_MAX_EVENTS=3
TICKETMASTER_COUNTRY_CODE=

FLIGHT_PROVIDER=mock
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_TIMEOUT_SECONDS=20
AMADEUS_CURRENCY_CODE=USD
AMADEUS_MAX_OFFERS=3
AMADEUS_ADULTS=1
LOCATION_CACHE_MAX_ENTRIES=128
PROVIDER_LOG_LEVEL=INFO
